{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lightelligence/claude_kit/dv-plan.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "inputs",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "spec_ref",
          "configurations",
          "open_questions",
          "open_bugs",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "spec_ref": {
            "type": "string",
            "minLength": 1
          },
          "configurations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "open_bugs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "method",
                "test",
                "checkers",
                "coverage_targets",
                "require_negative_control"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "simulation",
                    "formal"
                  ]
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "checkers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "coverage_targets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "require_negative_control": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
