{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lightelligence/claude_kit/evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "project", "task", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "operation": {"enum": ["modify", "delete"]}
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "blocked", "skipped", "unknown"]},
          "command": {"type": "array", "items": {"type": "string"}},
          "artifacts": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "items": {"type": "string", "minLength": 1}}
            ]
          },
          "artifact": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "items": {"type": "string", "minLength": 1}}
            ]
          }
        }
      }
    },
    "skipped": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
    "risks": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}}
  }
}
