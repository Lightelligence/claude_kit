{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lightelligence/claude_kit/evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "project", "task", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string"},
    "changes": {"type": "array"},
    "checks": {"type": "array"},
    "skipped": {"type": "array"},
    "risks": {"type": "array"}
  }
}
